<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net46</TargetFramework>
    <AssemblyName>KKS_FreeHStudioSceneLoader</AssemblyName>
    <RootNamespace>KKS_FreeHStudioSceneLoader</RootNamespace>
    <LangVersion>latest</LangVersion>
    <DefineConstants>$(DefineConstants);KKS</DefineConstants>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>embedded</DebugType>
    <!-- Keep the local folder out of the embedded PDB (source paths start at the project folder) -->
    <PathMap>$(MSBuildProjectDirectory)=KKS_FreeHStudioSceneLoader</PathMap>
    <!-- Emits SkipVerification/UnverifiableCode so Mono allows access to members made public by the publicized reference assemblies -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- Game/BepInEx reference assemblies from the IllusionMods feed (not committed to the repo) -->
    <PackageReference Include="IllusionLibs.KoikatsuSunshine.AllPackages" Version="*" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="ExtensibleSaveFormat.KoikatsuSunshine" Version="21.0" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="BepInEx.Analyzers" Version="1.*" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.Unity.Analyzers" Version="1.*" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <!-- Original KK source kept for reference only -->
    <Compile Remove="upstream/**" />
    <None Include="upstream/**" />
  </ItemGroup>
</Project>
